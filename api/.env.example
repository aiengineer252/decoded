# Required for the triage stage.
ANTHROPIC_API_KEY=

# Optional. Raises the GitHub API rate limit from 60/hr to 5000/hr.
# A classic token with no scopes is enough — this only reads public data.
GITHUB_TOKEN=

# sqlite for local dev; swap for a postgres URL in production.
DATABASE_URL=sqlite:///./decoded.db

# Items below this signal score never reach the (expensive) triage stage.
SIGNAL_THRESHOLD=0.45

# Model used for triage. See api/app/triage/pipeline.py for why.
TRIAGE_MODEL=claude-opus-5
